<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadContent</key>
      <dict>
        <key>org.mozilla.firefox</key>
        <dict>
          <key>Forced</key>
          <array>
            <dict>
              <key>mcx_preference_settings</key>
              <dict>
                <key>EnterprisePoliciesEnabled</key>
                <true/>
                <key>SearchEngines</key>
                <dict>
                  <key>Add</key>
                  <array>
                    <dict>
                      <key>Name</key>
                      <string>I'm Feeling Lucky</string>
                      <key>URLTemplate</key>
                      <string>https://www.google.com/search?btnI=1&amp;q={searchTerms}</string>
                      <key>Alias</key>
                      <string>!</string>
                    </dict>
                  </array>
                </dict>
              </dict>
            </dict>
          </array>
        </dict>
      </dict>
      <key>PayloadDisplayName</key>
      <string>Firefox Policies</string>
      <key>PayloadIdentifier</key>
      <string>dev.james.firefox.preferences</string>
      <key>PayloadType</key>
      <string>com.apple.ManagedClient.preferences</string>
      <key>PayloadUUID</key>
      <string>559DAA74-58C4-4CF3-814D-80645ED09B6D</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
    </dict>
  </array>
  <key>PayloadDescription</key>
  <string>Adds an I'm Feeling Lucky search shortcut to Firefox.</string>
  <key>PayloadDisplayName</key>
  <string>Firefox: I'm Feeling Lucky</string>
  <key>PayloadIdentifier</key>
  <string>dev.james.firefox.feeling-lucky</string>
  <key>PayloadOrganization</key>
  <string>James Lochhead</string>
  <key>PayloadScope</key>
  <string>User</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>D7A13D1A-839E-4CE9-9072-F55D15165045</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
