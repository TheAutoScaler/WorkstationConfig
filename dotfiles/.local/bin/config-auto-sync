#!/bin/sh
set -eu

repo="${HOME:?HOME must be set}/Config"
lock_dir="$HOME/Library/Caches/config-auto-sync.lock"
log_file="$HOME/Library/Logs/config-auto-sync.log"

mkdir -p "$(dirname "$log_file")" "$(dirname "$lock_dir")"
exec >>"$log_file" 2>&1

if ! mkdir "$lock_dir" 2>/dev/null; then
    exit 0
fi
trap 'rmdir "$lock_dir"' EXIT HUP INT TERM

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "config-auto-sync: refusing to sync because gitleaks is not installed"
    exit 1
fi

if ! git -C "$repo" diff --quiet ||
    ! git -C "$repo" diff --cached --quiet ||
    test -n "$(git -C "$repo" ls-files --others --exclude-standard)"; then
    # Scan the complete working tree before staging, then scan the exact staged
    # snapshot. Either check failing prevents both the commit and the push.
    gitleaks dir "$repo" --redact --no-banner
    git -C "$repo" add --all
    gitleaks git "$repo" --pre-commit --staged --redact --no-banner
    git -C "$repo" commit -m "chore: auto-sync config $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
fi

# Push the checked-out branch. Configure its upstream on the first run.
if git -C "$repo" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    git -C "$repo" push
else
    git -C "$repo" push --set-upstream origin HEAD
fi
